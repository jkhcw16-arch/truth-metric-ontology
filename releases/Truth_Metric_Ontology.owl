 <owl:Ontology rdf:about="https://w3id.org/truth-metric">
  <rdfs:label xml:lang="en">Truth Metric Ontology</rdfs:label>
  <dcterms:description xml:lang="en">Domain-neutral ontology for assertions, propositions, evidence, provenance, temporal relationships, truth assessments, and findings.</dcterms:description>
  <owl:versionInfo>1.0.0</owl:versionInfo><owl:versionIRI rdf:resource="https://w3id.org/truth-metric/1.0.0"/>
  <owl:imports rdf:resource="http://www.w3.org/ns/prov-o"/>
 </owl:Ontology>
