 <owl:Class rdf:about="https://w3id.org/truth-metric#SourceEntity"><rdfs:label xml:lang="en">Source Entity</rdfs:label><rdfs:subClassOf rdf:resource="https://w3id.org/truth-metric#Entity"/></owl:Class>
