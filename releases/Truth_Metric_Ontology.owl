 <owl:NamedIndividual rdf:about="https://w3id.org/truth-metric#UNKNOWN"><rdf:type rdf:resource="https://w3id.org/truth-metric#GateState"/><rdfs:label xml:lang="en">Unknown</rdfs:label></owl:NamedIndividual>
 <owl:NamedIndividual rdf:about="https://w3id.org/truth-metric#NOT_APPLICABLE"><rdf:type rdf:resource="https://w3id.org/truth-metric#GateState"/><rdfs:label xml:lang="en">Not Applicable</rdfs:label></owl:NamedIndividual>
 <owl:NamedIndividual rdf:about="https://w3id.org/truth-metric#PERFORMED"><rdf:type rdf:resource="https://w3id.org/truth-metric#OmissionState"/><rdfs:label xml:lang="en">Performed</rdfs:label></owl:NamedIndividual>
 <owl:NamedIndividual rdf:about="https://w3id.org/truth-metric#OMITTED"><rdf:type rdf:resource="https://w3id.org/truth-metric#OmissionState"/><rdfs:label xml:lang="en">Omitted</rdfs:label></owl:NamedIndividual>
 <owl:NamedIndividual rdf:about="https://w3id.org/truth-metric#OMISSION_UNKNOWN"><rdf:type rdf:resource="https://w3id.org/truth-metric#OmissionState"/><rdfs:label xml:lang="en">Omission Unknown</rdfs:label></owl:NamedIndividual>
 <owl:NamedIndividual rdf:about="https://w3id.org/truth-metric#OMISSION_NOT_APPLICABLE"><rdf:type rdf:resource="https://w3id.org/truth-metric#OmissionState"/><rdfs:label xml:lang="en">Omission Not Applicable</rdfs:label></owl:NamedIndividual>
 <owl:AnnotationProperty rdf:about="https://w3id.org/truth-metric#validationRule"><rdfs:label xml:lang="en">validation rule</rdfs:label></owl:AnnotationProperty>
 <rdf:Description rdf:about="https://w3id.org/truth-metric#TruthAssessment"><tmo:validationRule xml:lang="en">truthScore must be in [-1,1] when present.</tmo:validationRule><tmo:validationRule xml:lang="en">semanticMatch, evidenceQuality, and contradictionScore must be in [0,1] when present.</tmo:validationRule><tmo:validationRule xml:lang="en">Normative or legal classification must remain separate from truth correspondence.</tmo:validationRule></rdf:Description>
 <rdf:Description rdf:about="https://w3id.org/truth-metric#Proposition"><tmo:validationRule xml:lang="en">A proposition must not be inferred true solely from repeated assertions.</tmo:validationRule></rdf:Description>
 <rdf:Description rdf:about="https://w3id.org/truth-metric#Finding"><tmo:validationRule xml:lang="en">A completed finding must preserve material limitations and unresolved facts.</tmo:validationRule></rdf:Description>
</rdf:RDF>
