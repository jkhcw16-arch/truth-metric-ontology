  <rdfs:subClassOf><owl:Restriction><owl:onProperty rdf:resource="https://w3id.org/truth-metric#usesRuleSet"/><owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality><owl:onClass rdf:resource="https://w3id.org/truth-metric#RuleSet"/></owl:Restriction></rdfs:subClassOf>
